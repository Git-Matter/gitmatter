{
  "version": 1,
  "description": "Canonical gitmatter foundations. Edit here, then run vp run design:generate.",
  "shared": {
    "--radius": "0.625rem"
  },
  "utilities": {
    "--font-heading": "var(--font-serif)",
    "--color-destructive-surface": "var(--destructive-surface)",
    "--color-destructive-border": "var(--destructive-border)",
    "--color-success": "var(--success)",
    "--color-success-surface": "var(--success-surface)",
    "--color-warning": "var(--warning)",
    "--color-warning-surface": "var(--warning-surface)",
    "--color-ink-secondary": "var(--ink-secondary)",
    "--color-bronze": "var(--foreground)",
    "--color-bronze-tint": "var(--muted)",
    "--spacing-field": "0.375rem",
    "--spacing-stack": "1rem",
    "--spacing-section": "2.5rem",
    "--spacing-page": "2rem",
    "--spacing-band": "4rem",
    "--spacing-feature": "8rem",
    "--shadow-float": "0 4px 16px rgb(15 14 13 / 0.1)",
    "--shadow-modal": "0 12px 40px rgb(15 14 13 / 0.16)",
    "--radius-sm": "calc(var(--radius) * 0.6)",
    "--radius-md": "calc(var(--radius) * 0.8)",
    "--radius-lg": "var(--radius)",
    "--radius-xl": "calc(var(--radius) * 1.4)",
    "--radius-2xl": "calc(var(--radius) * 1.8)",
    "--radius-3xl": "calc(var(--radius) * 2.2)",
    "--radius-4xl": "calc(var(--radius) * 2.6)",
    "--font-sans": "\"Inter Variable\", sans-serif",
    "--font-serif": "\"Newsreader Variable\", Georgia, ui-serif, serif",
    "--spacing-navigation": "14rem",
    "--spacing-chrome": "3.5rem",
    "--spacing-work": "1.25rem",
    "--spacing-inspector": "24rem",
    "--spacing-review-row": "2.75rem",
    "--spacing-review-header": "2.25rem",
    "--color-grid-line": "var(--grid-line)",
    "--spacing-navigation-mobile": "18rem",
    "--spacing-navigation-compact": "3rem"
  },
  "themes": {
    "light": {
      "color-scheme": "light",
      "--background": "#fafaf9",
      "--foreground": "#0f0e0d",
      "--card": "#ffffff",
      "--card-foreground": "#0f0e0d",
      "--popover": "#ffffff",
      "--popover-foreground": "#0f0e0d",
      "--primary": "#0f0e0d",
      "--primary-foreground": "#ffffff",
      "--secondary": "#f2f1f0",
      "--secondary-foreground": "#33312c",
      "--muted": "#f2f1f0",
      "--muted-foreground": "#706d66",
      "--accent": "#eae8e5",
      "--accent-foreground": "#0f0e0d",
      "--destructive": "#a12d25",
      "--border": "#cccac6",
      "--input": "#8f8b85",
      "--ring": "#005fcc",
      "--chart-1": "#33312c",
      "--chart-2": "#706d66",
      "--chart-3": "#8f8b85",
      "--chart-4": "#adaba5",
      "--chart-5": "#cccac6",
      "--sidebar": "#f2f1f0",
      "--sidebar-foreground": "#33312c",
      "--sidebar-primary": "#0f0e0d",
      "--sidebar-primary-foreground": "#ffffff",
      "--sidebar-accent": "#e7e5e1",
      "--sidebar-accent-foreground": "#0f0e0d",
      "--sidebar-border": "#cccac6",
      "--sidebar-ring": "#005fcc",
      "--ink-secondary": "#33312c",
      "--destructive-surface": "#fbece9",
      "--destructive-border": "#e1b1ab",
      "--success": "#285d40",
      "--success-surface": "#edf4ee",
      "--warning": "#795010",
      "--warning-surface": "#faf1df",
      "--grid-line": "#e5e4e1"
    },
    "dark": {
      "color-scheme": "dark",
      "--background": "#0f0e0d",
      "--foreground": "#fafaf9",
      "--card": "#1f1d1a",
      "--card-foreground": "#fafaf9",
      "--popover": "#1f1d1a",
      "--popover-foreground": "#fafaf9",
      "--primary": "#fafaf9",
      "--primary-foreground": "#0f0e0d",
      "--secondary": "#292723",
      "--secondary-foreground": "#e7e5e1",
      "--muted": "#292723",
      "--muted-foreground": "#b4b0a8",
      "--accent": "#33312c",
      "--accent-foreground": "#fafaf9",
      "--destructive": "#f2978e",
      "--border": "#44413a",
      "--input": "#8f8b85",
      "--ring": "#99c8ff",
      "--chart-1": "#f2f1f0",
      "--chart-2": "#cccac6",
      "--chart-3": "#adaba5",
      "--chart-4": "#8f8b85",
      "--chart-5": "#706d66",
      "--sidebar": "#1a1815",
      "--sidebar-foreground": "#e7e5e1",
      "--sidebar-primary": "#fafaf9",
      "--sidebar-primary-foreground": "#0f0e0d",
      "--sidebar-accent": "#33312c",
      "--sidebar-accent-foreground": "#fafaf9",
      "--sidebar-border": "#44413a",
      "--sidebar-ring": "#99c8ff",
      "--ink-secondary": "#e7e5e1",
      "--destructive-surface": "#39211e",
      "--destructive-border": "#74463f",
      "--success": "#a6d2b3",
      "--success-surface": "#1c3023",
      "--warning": "#e6c681",
      "--warning-surface": "#352b19",
      "--grid-line": "#373531"
    }
  },
  "recipes": {
    "text-display": {
      "font-family": "var(--font-heading)",
      "font-size": "clamp(2.75rem, 5.2vw, 4.5rem)",
      "font-weight": "400",
      "line-height": "1.05",
      "letter-spacing": "-0.0125em",
      "text-wrap": "balance"
    },
    "text-section": {
      "font-family": "var(--font-heading)",
      "font-size": "clamp(2rem, 3.5vw, 3rem)",
      "font-weight": "400",
      "line-height": "1.1",
      "letter-spacing": "-0.01em",
      "text-wrap": "balance"
    },
    "text-title": {
      "font-family": "var(--font-sans)",
      "font-size": "1.25rem",
      "font-weight": "500",
      "line-height": "1.3"
    },
    "text-lead": {
      "font-size": "1.25rem",
      "font-weight": "400",
      "line-height": "1.5"
    },
    "page-container": {
      "width": "100%",
      "max-width": "80rem",
      "margin-inline": "auto",
      "padding-inline": "clamp(1.5rem, 4vw, 3rem)"
    },
    "sticky-name": {
      "position": "sticky",
      "left": "0",
      "z-index": "30",
      "background-color": "var(--card)"
    },
    "serif-input": {
      "font-family": "var(--font-heading)",
      "font-size": "1.5rem",
      "line-height": "2rem",
      "background": "transparent",
      "outline": "none"
    }
  }
}
