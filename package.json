{
  "name": "gitmatter",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "docs:tools": "tsx scripts/generate-mcp-docs.ts",
    "docs:tools:check": "tsx scripts/generate-mcp-docs.ts --check",
    "docs:build": "turbo run build --filter=docs",
    "docs:dev": "turbo run dev --filter=docs",
    "dev": "tsx scripts/dev.ts",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "vp test",
    "check": "vp check",
    "prepare": "vp config",
    "fixtures:nda": "tsx scripts/generate-nda-fixture.ts",
    "fixtures:nda:check": "tsx scripts/generate-nda-fixture.ts --check",
    "design:generate": "tsx design/tooling/design-tokens.ts",
    "design:check": "tsx design/tooling/check-design.ts"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "turbo": "^2.9.17",
    "typescript": "^6",
    "vite-plus": "catalog:",
    "tsx": "^4.23.15"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "posthog-node": "^5.45.2"
  }
}
