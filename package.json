{
  "name": "gitmatter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "vp run --filter './apps/*' --filter './packages/*' --filter './cli' build",
    "docs:build": "vp run docs#build",
    "docs:dev": "vp run docs#dev",
    "dev": "node --env-file-if-exists=.env scripts/dev.ts",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "vp run --filter './apps/*' --filter './packages/*' --filter './cli' typecheck",
    "test": "vp test run",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.ts",
    "db:restore": "node --env-file-if-exists=.env scripts/db-restore.ts",
    "check": "vp check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "dotenv": "^17.4.2",
    "@types/node": "^26",
    "typescript": "^6",
    "tsx": "^4.21.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "dependencies": {
    "posthog-node": "^5.45.2"
  }
}
