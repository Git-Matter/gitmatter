{
  "name": "gitmatter",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "docs:build": "turbo run build --filter=docs",
    "docs:dev": "turbo run dev --filter=docs",
    "dev": "tsx scripts/dev.ts",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "vp check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "turbo": "^2.9.17",
    "typescript": "^6",
    "vite-plus": "catalog:",
    "tsx": "^4.23.15"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.14.1"
  }
}
