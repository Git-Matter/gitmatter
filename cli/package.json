{
  "name": "gitmatter-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "gitmatter": "./src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build": "vp pack --filter host",
    "build:all": "vp pack --filter all",
    "build:darwin-arm64": "vp pack --filter darwin-arm64",
    "build:darwin-x64": "vp pack --filter darwin-x64",
    "build:linux-x64": "vp pack --filter linux-x64",
    "build:win-x64": "vp pack --filter win-x64",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^6.0.3",
    "@tsdown/exe": "0.22.1",
    "vite-plus": "catalog:"
  }
}
